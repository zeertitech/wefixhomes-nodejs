# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/fashion_ecommerce

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookies (Optional for Production) ──────────────────────
# COOKIE_DOMAIN=.shanandralabel.com   # Leave unset for localhost / host-only
# COOKIE_SAME_SITE=lax               # 'lax' | 'strict' | 'none'
# COOKIE_SECRET=your_cookie_signing_secret_here

# ─── Security ────────────────────────────────────────────────
PEPPER_SECRET=your_pepper_secret_minimum_32_characters_here!!

# ─── Email (optional until a WeFixHomes mailbox is configured) ─
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=WeFixHomes <noreply@wefixhomes.in>

# ─── Cloudflare R2 (optional until uploads are used) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PUBLIC_FOLDER_CATEGORY=categories
# Home-service images. The commerce product routes are not mounted.
R2_PUBLIC_FOLDER_PRODUCT=services
R2_PUBLIC_FOLDER_PROFILE=profile

# ─── Razorpay (optional; commerce routes are not mounted) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── 2Factor SMS (optional) ──────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_NAME=ORDERCONF

# ─── Shiprocket (optional; commerce routes are not mounted) ─
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ─── Admin seed (npm run db:seed:wefixhomes only) ────────────
# ADMIN_EMAIL=admin@wefixhomes.in
# ADMIN_PASSWORD=choose-a-password-at-least-12-characters

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://wefixhomes.in,https://www.wefixhomes.in

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ─── File Upload ─────────────────────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
